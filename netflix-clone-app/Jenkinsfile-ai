pipeline {

    agent any

    stages {

        stage('Repository Ready') {
            steps {
                echo 'Repository checked out by Jenkins'
            }
        }

        stage('Verify AI Module') {
            steps {

                sh '''
                echo "Checking AI Module..."

                ls -lah

                test -d ai-security

                echo "AI Module Found"
                '''
            }
        }

        stage('Install Python Packages') {
    steps {
        sh '''
        python3 --version

        # Create virtual environment
        python3 -m venv ai-security/venv

        # Activate it
        . ai-security/venv/bin/activate

        # Upgrade pip inside the venv
        pip install --upgrade pip

        # Install dependencies
        pip install -r ai-security/requirements.txt

        # Verify installation
        pip list
        '''
    }
}

        stage('Merge Reports') {
    steps {
        sh '''
        . ai-security/venv/bin/activate

        python ai-security/scripts/merge_reports.py
        '''
    }
}

    }

    post {

        success {

            echo "AI Pipeline Ready"

        }

        failure {

            echo "AI Pipeline Failed"

        }

    }

}
