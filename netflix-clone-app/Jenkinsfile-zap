    agent any

    environment {
        REPORT_DIR = "zap-report"
    }

    stages {

        stage('Check Netflix Application') {
            steps {
                sh '''
                docker ps | grep netflix-app || {
                    echo "ERROR: Netflix application is not running!"
                    exit 1
                }
                '''
            }
        }

        stage('Create Report Directory') {
            steps {
                sh '''
                rm -rf $REPORT_DIR
                mkdir -p $REPORT_DIR
                chmod -R 777 $REPORT_DIR
                '''
            }
        }

        stage('Run OWASP ZAP DAST Scan') {
            steps {
                sh '''
                docker pull zaproxy/zap-stable

                docker run --rm \
                  --user root \
                  --network devsecops-network \
                  -v $WORKSPACE/$REPORT_DIR:/zap/wrk:rw \
                  zaproxy/zap-stable \
                  zap-baseline.py \
                  -t http://netflix-app \
                  -r zap-report.html \
                  -x zap-report.xml \
                  -J zap-report.json \
                  -w zap-report.md \
                  -I

                chmod -R 777 $REPORT_DIR

                echo "======================================"
                echo "Generated ZAP Reports"
                echo "======================================"

                ls -lah $REPORT_DIR
                '''
            }
        }

        stage('Archive Reports') {
            steps {
                archiveArtifacts artifacts: 'zap-report/*', fingerprint: true
            }
        }

        stage('Publish HTML Report') {
            steps {
                publishHTML(target: [
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'zap-report',
                    reportFiles: 'zap-report.html',
                    reportName: 'OWASP ZAP DAST Report'
                ])
            }
        }
    }

    post {

        always {
            echo '======================================'
            echo 'OWASP ZAP Scan Finished'
            echo '======================================'
        }

        success {
            echo 'DAST Scan Completed Successfully'
        }

        failure {
            echo 'DAST Scan Failed'
        }
    }
}
