pipeline {
    agent any

    environment {
        IMAGE_NAME = "netflix-clone:v1"
        REPORT_DIR = "security/trivy"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Create Report Directory') {
            steps {
                sh '''
                mkdir -p ${REPORT_DIR}
                chmod -R 777 ${REPORT_DIR}
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                docker pull aquasec/trivy:latest

                docker run --rm \
                  -v /var/run/docker.sock:/var/run/docker.sock \
                  -v $WORKSPACE/${REPORT_DIR}:/report \
                  aquasec/trivy:latest image \
                  --format json \
                  --output /report/trivy-report.json \
                  ${IMAGE_NAME}
                '''
            }
        }

        stage('Verify Report') {
            steps {
                sh '''
                echo "==========================="
                echo "Generated Trivy Report"
                echo "==========================="

                ls -lah ${REPORT_DIR}

                test -f ${REPORT_DIR}/trivy-report.json
                '''
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts artifacts: 'security/trivy/trivy-report.json', fingerprint: true
            }
        }
    }

    post {

        success {
            echo 'Trivy JSON Report Generated Successfully'
        }

        failure {
            echo 'Trivy Scan Failed'
        }

        always {
            echo 'Trivy Pipeline Finished'
        }
    }
}
