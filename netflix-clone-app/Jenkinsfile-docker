pipeline {
    agent any

    stages {

        stage('GitHub Checkout') {
            steps {
                echo 'Repository checked out from GitHub'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('netflix-clone-app') {
                    withCredentials([
                        string(credentialsId: 'tmdb-api-key', variable: 'TMDB_KEY')
                    ]) {
                        sh '''
                        docker build \
                          --build-arg TMDB_V3_API_KEY=$TMDB_KEY \
                          -t netflix-clone:v1 .
                        '''
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                trivy image \
                  --severity HIGH,CRITICAL \
                  netflix-clone:v1
                '''
            }
        }

        stage('Run Docker Container') {
            steps {
                sh '''
                docker stop netflix-app || true
                docker rm -f netflix-app || true

                docker run -d \
                  --name netflix-app \
                  --network devsecops-network \
                  -p 3000:80 \
                  netflix-clone:v1
                '''
            }
        }

        stage('Verify Container') {
            steps {
                sh '''
                sleep 5
                docker ps | grep netflix-app
                '''
            }
        }
    }

    post {

        success {
            echo 'Docker Pipeline Successful'
        }

        failure {
            echo 'Docker Pipeline Failed'
        }

        always {
            echo 'Docker Pipeline Finished'
        }
    }
}
