pipeline {
    agent any

    environment {
        REPORT_DIR = "zap-report"
        TARGET_URL = "http://netflix-app"
    }

    stages {

        stage('Check Netflix Application') {
            steps {
                sh '''
                echo "Checking Netflix container..."

                docker ps | grep netflix-app || {
                    echo "Netflix container is not running!"
                    exit 1
                }

                echo "Container Found."
                '''
            }
        }

        stage('Prepare Report Directory') {
            steps {
                sh '''
                rm -rf $REPORT_DIR
                mkdir -p $REPORT_DIR
                chmod -R 777 $REPORT_DIR
                '''
            }
        }

        stage('Run OWASP ZAP DAST Scan') {
            steps {
                sh '''
                echo "Pulling latest ZAP image..."

                docker pull ghcr.io/zaproxy/zaproxy:stable

                echo "Starting ZAP Scan..."

                docker run --rm \
                  --user root \
                  --network devsecops-network \
                  -v "$WORKSPACE/$REPORT_DIR:/zap/wrk:rw" \
                  ghcr.io/zaproxy/zaproxy:stable \
                  zap-baseline.py \
                  -t $TARGET_URL \
                  -r zap-report.html \
                  -x zap-report.xml \
                  -J zap-report.json \
                  -w zap-report.md \
                  -I || true

                chmod -R 777 $REPORT_DIR

                echo ""
                echo "=============================="
                echo "Generated Report Files"
                echo "=============================="

                ls -lah $WORKSPACE/$REPORT_DIR || true
                '''
            }
        }

        stage('Archive Reports') {
            steps {
                archiveArtifacts artifacts: 'zap-report/**', allowEmptyArchive: true
            }
        }

        stage('Publish HTML Report') {
            steps {
                publishHTML(target: [
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'zap-report',
                    reportFiles: 'zap-report.html',
                    reportName: 'OWASP ZAP DAST Report'
                ])
            }
        }

    }

    post {

        always {
            echo "==================================="
            echo "OWASP ZAP Scan Finished"
            echo "==================================="

            sh '''
            echo ""
            echo "Workspace Reports:"
            ls -lah zap-report || true
            '''
        }

        success {
            echo "DAST Scan Completed Successfully"
        }

        unstable {
            echo "DAST Scan Completed With Warnings"
        }

        failure {
            echo "DAST Scan Failed"
        }
    }
}
