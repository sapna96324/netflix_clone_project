pipeline {
    agent any

    environment {

        REPORT_DIR = "security/zap"

        ARTIFACT_DIR = "/var/jenkins_home/devsecops-artifacts/zap"

        TARGET_URL = "http://netflix-app"

    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Report Directory') {
            steps {
                sh '''
                rm -rf ${REPORT_DIR}
                mkdir -p ${REPORT_DIR}
                chmod -R 777 ${REPORT_DIR}
                '''
            }
        }

stage('Run ZAP Scan') {
    steps {
        sh '''
        echo "======================================"
        echo "Pulling ZAP Docker Image"
        echo "======================================"

        docker pull ghcr.io/zaproxy/zaproxy:stable

stage('Run ZAP Scan') {
    steps {
        sh '''
        echo "======================================"
        echo "Pulling ZAP Docker Image"
        echo "======================================"

        docker pull ghcr.io/zaproxy/zaproxy:stable

        echo ""
        echo "======================================"
        echo "Running ZAP Baseline Scan"
        echo "======================================"

        docker run --rm \
          --user root \
          --network devsecops-network \
          -v "$WORKSPACE/${REPORT_DIR}:/zap/wrk" \
          ghcr.io/zaproxy/zaproxy:stable \
          zap-baseline.py \
          --autooff \
          -t ${TARGET_URL} \
          -J zap-report.json \
          -I || true

        echo ""
        echo "======================================"
        echo "Listing generated reports"
        echo "======================================"

        find ${REPORT_DIR} -type f

        echo ""
        echo "======================================"
        echo "Directory Contents"
        echo "======================================"

        ls -lah ${REPORT_DIR}
        '''
    }
}
      

        stage('Verify Report') {
            steps {
                sh '''
                echo ""
                echo "Generated Files"

                ls -lah ${REPORT_DIR}

                if [ -f ${REPORT_DIR}/zap-report.json ]; then
                    echo ""
                    echo "SUCCESS : zap-report.json generated"
                else
                    echo ""
                    echo "ERROR : zap-report.json not found"
                    exit 1
                fi
                '''
            }
        }

        stage('Publish Report') {
            steps {
                sh '''
                mkdir -p ${ARTIFACT_DIR}

                cp ${REPORT_DIR}/zap-report.json \
                   ${ARTIFACT_DIR}/

                ls -lah ${ARTIFACT_DIR}
                '''
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts(
                    artifacts: 'security/zap/zap-report.json',
                    fingerprint: true,
                    allowEmptyArchive: false
                )
            }
        }

    }

    post {

        success {
            echo "======================================"
            echo "ZAP Pipeline Successful"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "ZAP Pipeline Failed"
            echo "======================================"
        }

        always {
            echo "Pipeline Finished"
        }

    }
}
