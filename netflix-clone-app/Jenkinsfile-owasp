pipeline {
    agent any

    environment {
        REPORT_DIR = "security/dependency-check"
    }

    stages {

        stage('Repository Ready') {
            steps {
                echo 'Repository already checked out by Jenkins'
            }
        }

        stage('Prepare Report Directory') {
            steps {
                sh '''
                rm -rf ${REPORT_DIR}
                mkdir -p ${REPORT_DIR}
                chmod -R 777 ${REPORT_DIR}
                '''
            }
        }

        stage('OWASP Dependency Check Scan') {
            steps {
                dir('netflix-clone-app') {
                    dependencyCheck(
                        odcInstallation: 'OWASP',
                        additionalArguments: """
                        --scan . \
                        --format XML \
                        --format JSON \
                        --out ../${REPORT_DIR} \
                        --noupdate
                        """
                    )
                }
            }
        }

        stage('Verify Reports') {
            steps {
                sh '''
                echo "=================================="
                echo "Generated Reports"
                echo "=================================="

                ls -lah ${REPORT_DIR}

                if [ -f ${REPORT_DIR}/dependency-check-report.json ]; then
                    echo "SUCCESS : dependency-check-report.json generated"
                else
                    echo "ERROR : dependency-check-report.json not found"
                    exit 1
                fi
                '''
            }
        }

        stage('Publish OWASP Report') {
            steps {
                dependencyCheckPublisher(
                    pattern: 'security/dependency-check/dependency-check-report.xml'
                )
            }
        }

        stage('Archive Reports') {
            steps {
                archiveArtifacts(
                    artifacts: 'security/dependency-check/*',
                    fingerprint: true,
                    allowEmptyArchive: false
                )
            }
        }
    }

    post {

        success {
            echo '========================================'
            echo 'Dependency Check JSON Report Generated'
            echo '========================================'
        }

        failure {
            echo '========================================'
            echo 'Dependency Check Pipeline Failed'
            echo '========================================'
        }

        always {
            echo 'Pipeline Finished'
        }
    }
}
