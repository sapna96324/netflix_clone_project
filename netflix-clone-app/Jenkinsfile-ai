pipeline {

    agent any

    stages {

        stage('Repository Ready') {
            steps {
                echo 'Repository checked out by Jenkins'
            }
        }

        stage('Verify AI Module') {
            steps {
                sh '''
                echo "======================================"
                echo "Checking AI Module"
                echo "======================================"

                ls -lah

                test -d ai-security

                echo "AI Module Found"
                '''
            }
        }

        stage('Install Python Packages') {
            steps {
                sh '''
                python3 --version

                python3 -m venv ai-security/venv

                . ai-security/venv/bin/activate

                pip install --upgrade pip

                pip install -r ai-security/requirements.txt

                pip list
                '''
            }
        }

        stage('Merge Reports') {
            steps {
                sh '''
                . ai-security/venv/bin/activate

                echo "======================================"
                echo "Merging Security Reports"
                echo "======================================"

                python ai-security/scripts/merge_reports.py

                echo ""
                echo "Merged Report Directory"

                ls -lah ai-security/data

                if [ -f ai-security/data/merged_reports.json ]; then

                    echo ""
                    echo "SUCCESS : merged_reports.json created"

                    echo ""
                    echo "Preview"

                    head -30 ai-security/data/merged_reports.json

                else

                    echo ""
                    echo "ERROR : merged_reports.json not found"

                    exit 1

                fi
                '''
            }
        }

        stage('Prepare Dataset') {
            steps {
                sh '''
                . ai-security/venv/bin/activate

                python ai-security/scripts/prepare_dataset.py
                '''
            }
        }

        stage('Train AI Model') {
            steps {
                sh '''
                . ai-security/venv/bin/activate

                python ai-security/train.py
                '''
            }
        }

        stage('Predict Security Risk') {
            steps {
                sh '''
                . ai-security/venv/bin/activate

                python ai-security/predict.py
                '''
            }
        }

        stage('Generate HTML Report') {
            steps {
                sh '''
                . ai-security/venv/bin/activate

                python ai-security/scripts/generate_report.py
                '''
            }
        }

        stage('Archive AI Artifacts') {
            steps {
                archiveArtifacts(
                    artifacts: '''
ai-security/models/security_model.pkl,
ai-security/output/prediction.csv,
ai-security/output/security_report.html,
ai-security/data/merged_reports.json
''',
                    fingerprint: true
                )
            }
        }

    }

    post {

        success {

            echo "======================================"
            echo "AI Pipeline Successful"
            echo "======================================"

        }

        failure {

            echo "======================================"
            echo "AI Pipeline Failed"
            echo "======================================"

        }

        always {

            echo "Pipeline Finished"

        }

    }

}
