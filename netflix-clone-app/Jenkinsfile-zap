pipeline {
    agent any

    environment {
        REPORT_DIR = "zap-report"
        TARGET_URL = "http://netflix-app"
    }

    stages {

        stage('Repository Ready') {
            steps {
                echo "Repository already checked out by Jenkins"
            }
        }

        stage('Check Netflix Application') {
            steps {
                sh '''
                echo "Checking Netflix container..."

                docker ps | grep netflix-app || {
                    echo "Netflix container is not running!"
                    exit 1
                }

                echo "Container Found."
                '''
            }
        }

        stage('Prepare Report Directory') {
            steps {
                sh '''
                rm -rf ${REPORT_DIR}
                mkdir -p ${REPORT_DIR}
                chmod -R 777 ${REPORT_DIR}
                '''
            }
        }

        stage('Run OWASP ZAP DAST Scan') {
            steps {
                sh '''
                echo "=================================="
                echo "Pulling latest ZAP image..."
                echo "=================================="

                docker pull ghcr.io/zaproxy/zaproxy:stable

                echo ""
                echo "=================================="
                echo "Running ZAP Scan..."
                echo "=================================="

                docker run --rm \
                  --user root \
                  --network devsecops-network \
                  -v "$WORKSPACE/${REPORT_DIR}:/zap/wrk:rw" \
                  ghcr.io/zaproxy/zaproxy:stable \
                  sh -c "
                    zap-baseline.py \
                      -t ${TARGET_URL} \
                      -r zap-report.html \
                      -x zap-report.xml \
                      -J zap-report.json \
                      -w zap-report.md \
                      -I

                    echo ''
                    echo '===== INSIDE CONTAINER ====='
                    ls -lah /zap/wrk
                  "

                echo ""
                echo "=================================="
                echo "Jenkins Workspace"
                echo "=================================="

                ls -lah ${REPORT_DIR}

                echo ""
                echo "=================================="
                echo "Workspace Path"
                echo "=================================="

                pwd
                '''
            }
        }

        stage('Archive Reports') {
            steps {
                archiveArtifacts artifacts: 'zap-report/**', allowEmptyArchive: true
            }
        }

        stage('Publish HTML Report') {
            steps {
                publishHTML(target: [
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'zap-report',
                    reportFiles: 'zap-report.html',
                    reportName: 'OWASP ZAP DAST Report'
                ])
            }
        }
    }

    post {

        always {
            echo "=================================="
            echo "OWASP ZAP Pipeline Finished"
            echo "=================================="

            sh '''
            echo ""
            echo "===== Workspace Files ====="
            ls -lah zap-report || true
            '''
        }

        success {
            echo "OWASP ZAP Scan Successful"
        }

        failure {
            echo "OWASP ZAP Scan Failed"
        }
    }
}
