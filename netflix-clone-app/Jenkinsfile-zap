pipeline {
    agent any

    environment {
        REPORT_DIR = "zap-report"
        TARGET_URL = "http://netflix-app"
    }

    stages {

        stage('Repository Ready') {
            steps {
                echo 'Repository already checked out by Jenkins'
            }
        }

        stage('Check Netflix Application') {
            steps {
                sh '''
                echo "Checking Netflix container..."

                docker ps | grep netflix-app || {
                    echo "Netflix container is not running!"
                    exit 1
                }

                echo "Netflix container found."
                '''
            }
        }

        stage('Prepare Report Directory') {
            steps {
                sh '''
                rm -rf ${REPORT_DIR}
                mkdir -p ${REPORT_DIR}
                chmod -R 777 ${REPORT_DIR}
                '''
            }
        }

        stage('Run OWASP ZAP Scan') {
            steps {
                sh '''
                echo "Pulling latest ZAP image..."

                docker pull ghcr.io/zaproxy/zaproxy:stable

                echo "Running ZAP Baseline Scan..."

                docker run --rm \
                  --user root \
                  --network devsecops-network \
                  -v "$WORKSPACE/${REPORT_DIR}:/zap/wrk:rw" \
                  ghcr.io/zaproxy/zaproxy:stable \
                  zap-baseline.py \
                  -t ${TARGET_URL} \
                  -r zap-report.html \
                  -x zap-report.xml \
                  -J zap-report.json \
                  -w zap-report.md \
                  -I || true

                echo ""
                echo "Generated Files"

                ls -lah ${REPORT_DIR} || true
                '''
            }
        }

        stage('Publish HTML Report') {
            steps {
                publishHTML(target: [
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'zap-report',
                    reportFiles: 'zap-report.html',
                    reportName: 'OWASP ZAP DAST Report'
                ])
            }
        }

    }

    post {

        always {

            echo "======================================"
            echo "OWASP ZAP Scan Finished"
            echo "======================================"

            sh '''
            echo ""
            echo "Workspace Report Directory"

            ls -lah zap-report || true
            '''
        }

        success {
            echo "OWASP ZAP Pipeline Successful"
        }

        failure {
            echo "OWASP ZAP Pipeline Failed"
        }
    }
}
