pipeline {
    agent any

    environment {
        TARGET_URL = "http://netflix-app"
        REPORT_DIR = "security/zap"
        OUTPUT_DIR = "zap-output"
        ARTIFACT_DIR = "/var/jenkins_home/devsecops-artifacts/zap"
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Report Directory') {
            steps {
                sh '''
                rm -rf ${REPORT_DIR}
                rm -rf ${OUTPUT_DIR}

                mkdir -p ${REPORT_DIR}
                mkdir -p ${OUTPUT_DIR}

                chmod -R 777 ${REPORT_DIR}
                chmod -R 777 ${OUTPUT_DIR}
                '''
            }
        }

        stage('Run ZAP Scan') {
            steps {
                sh '''
                echo "======================================"
                echo "Pulling ZAP Docker Image"
                echo "======================================"

                docker pull ghcr.io/zaproxy/zaproxy:stable

                echo ""
                echo "======================================"
                echo "Running ZAP Baseline Scan"
                echo "======================================"

                docker run --rm \
                  --user root \
                  --network devsecops-network \
                  -v "$WORKSPACE/${OUTPUT_DIR}:/zap/wrk" \
                  ghcr.io/zaproxy/zaproxy:stable \
                  zap-baseline.py \
                  --autooff \
                  -t ${TARGET_URL} \
                  -J zap-report.json \
                  -I || true

                echo ""
                echo "======================================"
                echo "Generated Files"
                echo "======================================"

                ls -lah ${OUTPUT_DIR} || true

                if [ -f ${OUTPUT_DIR}/zap-report.json ]; then
                    cp ${OUTPUT_DIR}/zap-report.json ${REPORT_DIR}/
                    echo "Copied zap-report.json to ${REPORT_DIR}"
                else
                    echo "WARNING: ZAP did not generate JSON."
                fi

                ls -lah ${REPORT_DIR}
                '''
            }
        }

        stage('Verify Report') {
            steps {
                sh '''
                echo ""
                echo "======================================"
                echo "Checking ZAP Report"
                echo "======================================"

                if [ -f ${REPORT_DIR}/zap-report.json ]; then
                    echo "SUCCESS : zap-report.json generated"
                else
                    echo "WARNING : zap-report.json not generated"
                    echo "Creating empty JSON report..."

                    echo "{}" > ${REPORT_DIR}/zap-report.json
                fi

                ls -lah ${REPORT_DIR}
                '''
            }
        }

        stage('Publish Report') {
            steps {
                sh '''
                echo ""
                echo "======================================"
                echo "Publishing ZAP Report"
                echo "======================================"

                mkdir -p ${ARTIFACT_DIR}

                cp ${REPORT_DIR}/zap-report.json ${ARTIFACT_DIR}/

                ls -lah ${ARTIFACT_DIR}
                '''
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts(
                    artifacts: 'security/zap/zap-report.json',
                    fingerprint: true,
                    allowEmptyArchive: true
                )
            }
        }
    }

    post {

        success {
            echo "======================================"
            echo "ZAP Pipeline Successful"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "ZAP Pipeline Failed"
            echo "======================================"
        }

        always {
            echo "Pipeline Finished"
        }
    }
}
