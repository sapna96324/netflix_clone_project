pipeline {
    agent any

    environment {
        TARGET_URL = "http://netflix-app"
        REPORT_DIR = "security/zap"
    }

    stages {

        stage('Repository Ready') {
            steps {
                echo "Repository already checked out by Jenkins"
            }
        }

        stage('Check Netflix Application') {
            steps {
                sh '''
                echo "Checking Netflix container..."

                docker ps | grep netflix-app || {
                    echo "Netflix container is not running!"
                    exit 1
                }

                echo "Netflix container found."
                '''
            }
        }

        stage('Prepare Report Directory') {
            steps {
                sh '''
                rm -rf ${REPORT_DIR}
                mkdir -p ${REPORT_DIR}
                chmod -R 777 ${REPORT_DIR}
                '''
            }
        }

        stage('Run OWASP ZAP DAST Scan') {
            steps {
                sh '''
                echo "======================================"
                echo "Pulling Latest ZAP Image"
                echo "======================================"

                docker pull ghcr.io/zaproxy/zaproxy:stable

                echo ""
                echo "Removing old temporary container..."
                docker rm -f zap-temp >/dev/null 2>&1 || true

                echo ""
                echo "Creating temporary ZAP container..."

                docker create \
                  --name zap-temp \
                  --network devsecops-network \
                  ghcr.io/zaproxy/zaproxy:stable \
                  sh -c "
                    zap-baseline.py \
                      -t ${TARGET_URL} \
                      -r zap-report.html \
                      -x zap-report.xml \
                      -J zap-report.json \
                      -w zap-report.md \
                      -I
                  "

                echo ""
                echo "Starting ZAP Scan..."

                docker start -a zap-temp

                echo ""
                echo "Copying reports from container..."

                docker cp zap-temp:/zap/wrk/. ${REPORT_DIR}/

                echo ""
                echo "Removing temporary container..."

                docker rm -f zap-temp

                chmod -R 777 ${REPORT_DIR}

                echo ""
                echo "======================================"
                echo "Generated Reports"
                echo "======================================"

                ls -lah ${REPORT_DIR}
                '''
            }
        }

        stage('Verify Reports') {
            steps {
                sh '''
                test -f ${REPORT_DIR}/zap-report.json
                test -f ${REPORT_DIR}/zap-report.html
                test -f ${REPORT_DIR}/zap-report.xml
                test -f ${REPORT_DIR}/zap-report.md

                echo ""
                echo "======================================"
                echo "ZAP Reports Verified Successfully"
                echo "======================================"
                '''
            }
        }

        stage('Archive Reports') {
            steps {
                archiveArtifacts artifacts: 'security/zap/**', fingerprint: true
            }
        }

        stage('Publish HTML Report') {
            steps {
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'security/zap',
                    reportFiles: 'zap-report.html',
                    reportName: 'OWASP ZAP DAST Report'
                ])
            }
        }
    }

    post {

        always {
            echo "======================================"
            echo "OWASP ZAP Pipeline Finished"
            echo "======================================"

            sh '''
            echo ""
            echo "Workspace Report Files"

            ls -lah security/zap || true
            '''
        }

        success {
            echo "OWASP ZAP Scan Successful"
        }

        failure {
            echo "OWASP ZAP Scan Failed"
        }
    }
}
