pipeline {
    agent any

    environment {
        IMAGE_NAME = "netflix-clone:v1"
        REPORT_DIR = "security/trivy"
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Report Directory') {
            steps {
                sh '''
                rm -rf ${REPORT_DIR}
                mkdir -p ${REPORT_DIR}
                chmod -R 777 ${REPORT_DIR}
                '''
            }
        }

        stage('Pull Trivy Image') {
            steps {
                sh '''
                docker pull aquasec/trivy:latest
                '''
            }
        }

        stage('Run Trivy Scan') {
            steps {
                sh '''
                docker run --rm \
                  -v /var/run/docker.sock:/var/run/docker.sock \
                  -v $WORKSPACE/${REPORT_DIR}:/report \
                  aquasec/trivy:latest image \
                  --format json \
                  --output /report/trivy-report.json \
                  ${IMAGE_NAME} || true
                '''
            }
        }

        stage('Verify Report') {
            steps {
                sh '''
                echo "=================================="
                echo "Generated Files"
                echo "=================================="

                ls -lah ${REPORT_DIR}

                if [ -f ${REPORT_DIR}/trivy-report.json ]; then
                    echo "SUCCESS : trivy-report.json generated"
                else
                    echo "ERROR : trivy-report.json not found"
                    exit 1
                fi
                '''
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts(
                    artifacts: 'security/trivy/trivy-report.json',
                    fingerprint: true,
                    allowEmptyArchive: false
                )
            }
        }
    }

    post {

        success {
            echo '=================================='
            echo 'Trivy JSON Report Generated'
            echo '=================================='
        }

        failure {
            echo '=================================='
            echo 'Trivy Pipeline Failed'
            echo '=================================='
        }

        always {
            echo 'Pipeline Finished'
        }
    }
}
