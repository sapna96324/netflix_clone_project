pipeline {
    agent any

environment {
    IMAGE_NAME = "netflix-clone:v1"
    REPORT_DIR = "security/trivy"
    ARTIFACT_DIR = "/var/jenkins_home/devsecops-artifacts/trivy"
}
    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Report Directory') {
            steps {
                sh '''
                rm -rf ${REPORT_DIR}
                mkdir -p ${REPORT_DIR}
                chmod -R 777 ${REPORT_DIR}
                '''
            }
        }

       stage('Check Trivy Image') {
    steps {
        retry(3) {
            sh '''
            echo "======================================"
            echo "Checking Trivy Docker Image"
            echo "======================================"

            if docker image inspect aquasec/trivy:latest >/dev/null 2>&1; then
                echo "Using existing Trivy image."
            else
                echo "Downloading Trivy image..."
                docker pull aquasec/trivy:latest
            fi

            echo "Trivy image is ready."
            '''
        }
    }
}

        stage('Run Trivy Scan') {
            steps {
                sh '''
                echo "Starting Trivy Scan..."

                docker run --rm \
                  -v /var/run/docker.sock:/var/run/docker.sock \
                  aquasec/trivy:latest \
                  image \
                  --format json \
                  ${IMAGE_NAME} \
                  > ${REPORT_DIR}/trivy-report.json

                chmod 777 ${REPORT_DIR}/trivy-report.json
                '''
            }
        }

        stage('Verify Report') {
            steps {
                sh '''
                echo ""
                echo "========================================"
                echo "Generated Trivy Report"
                echo "========================================"

                ls -lah ${REPORT_DIR}

                if [ -f ${REPORT_DIR}/trivy-report.json ]; then
                    echo ""
                    echo "SUCCESS: trivy-report.json generated."
                else
                    echo ""
                    echo "ERROR: trivy-report.json not found!"
                    exit 1
                fi
                '''
            }
        }

stage('Publish Report') {
    steps {
        sh '''
        mkdir -p ${ARTIFACT_DIR}

        cp ${REPORT_DIR}/trivy-report.json \
           ${ARTIFACT_DIR}/

        echo ""
        echo "===================================="
        echo "Published Trivy Report"
        echo "===================================="

        ls -lah ${ARTIFACT_DIR}
        '''
    }
}

        stage('Archive Report') {
            steps {
                archiveArtifacts(
                    artifacts: 'security/trivy/trivy-report.json',
                    fingerprint: true,
                    allowEmptyArchive: false
                )
            }
        }
    }

    post {

        success {
            echo ""
            echo "========================================"
            echo "Trivy JSON Report Generated Successfully"
            echo "========================================"
        }

        failure {
            echo ""
            echo "========================================"
            echo "Trivy Pipeline Failed"
            echo "========================================"
        }

        always {
            echo ""
            echo "Pipeline Finished"
        }
    }
}
